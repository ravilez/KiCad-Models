
(rules PCB RS232_Connector
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 4265)
    (layer_rule F.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.2)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.8)
    )
  )
  (rule
    (width 1200.0)
    (clear 200.2)
    (clear 500.0 (type smd_to_turn_gap))
    (clear 50.0 (type smd_smd))
  )
  (padstack "Via[0-1]_1600:800_um"
    (shape
      (circle F.Cu 1600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 1600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_1600:800_um" "Via[0-1]_1600:800_um" default
  )
  (via 
    "Via[0-1]_1600:800_um-kicad_default" "Via[0-1]_1600:800_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_1600:800_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_1600:800_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 1200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "Net-(C1-Pad1)" "Net-(C1-Pad2)" "Net-(C2-Pad2)" "Net-(C2-Pad1)" "Net-(C3-Pad1)" +3V3 "Net-(C4-Pad2)" GND
    RX TX CTS RTS "Net-(J2-Pad1)" "TX_RS232" "RX_RS232" "Net-(J2-Pad4)"
    "Net-(J2-Pad6)" "Net-(J2-Pad9)" "CTS_RS232" "RTS_RS232" B1 B9 B2 B10
    B3 B11 B4 B12 B5 B13 B6 B14
    B7 B15 B8 B16 +5V "/Level Shifter/SDA" "/Level Shifter/SCL" "/Level Shifter/GND"
    "/Level Shifter/CLK0,GPIO4" "/Level Shifter/TX" "/Level Shifter/RX" "/Level Shifter/GPIO17" "/Level Shifter/GPIO18,PWM0" "/Level Shifter/GPIO27" "/Level Shifter/GPIO22" "/Level Shifter/GPIO23"
    "/Level Shifter/GPIO24" "/Level Shifter/SPI_MOSI0,GPIO10" "/Level Shifter/SPI_MISO0,GPIO9" "/Level Shifter/GPIO25" "/Level Shifter/SPI_SCLK0,GPIO11" "/Level Shifter/~CE0,GPIO08" "/Level Shifter/~CE1,GPIO07" "/Level Shifter/ID_SD,GPIO0"
    "/Level Shifter/ID_SC,GPIO1" "/Level Shifter/CLK1,GPIO5" "/Level Shifter/CLK2,GPIO6" "/Level Shifter/PWM0,GPIO12" "/Level Shifter/PWM1,GPIO13" "/Level Shifter/SPI_MISO1,GPIO19" "/Level Shifter/GPIO16" "/Level Shifter/GPIO26"
    "/Level Shifter/SPI_MOSI1,GPIO20" "/Level Shifter/SPI_SCLK1,GPIO21" "Net-(Q1-Pad2)" "Net-(Q2-Pad2)" "Net-(Q3-Pad2)" "Net-(Q4-Pad2)" "Net-(Q5-Pad2)" "Net-(Q6-Pad2)"
    "Net-(Q7-Pad2)" "Net-(Q8-Pad2)" "Net-(Q9-Pad2)" "Net-(Q10-Pad2)" "Net-(Q11-Pad2)" "Net-(Q12-Pad2)" "Net-(Q13-Pad2)" "Net-(Q14-Pad2)"
    "Net-(Q15-Pad2)" "Net-(Q16-Pad2)"
    (clearance_class "kicad_default")
    (via_rule kicad_default)
    (rule
      (width 1200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)